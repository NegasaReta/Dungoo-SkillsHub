# Neon Postgres. Local fallback: sqlite:///./dungoo.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&channel_binding=require
# Google AI Studio key: scores answers, chooses the next question, and can speak them.
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# Text-mode communication coach. Voice mode needs no key here — ElevenLabs holds its own.
GEMINI_API_KEY=
SECRET_KEY=change-me
# Use "*" for local dev only — lock this down before any real deployment.
CORS_ORIGINS=*
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Origin the password reset link points at.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30
# Returns the reset token in the API response so the flow can be tested without
# an email provider. MUST stay false anywhere reachable from the internet: it
# would let anyone reset any account.
DEV_EXPOSE_RESET_TOKEN=false

# --- Interview voice providers ---
# Server-side only. Never expose these to the frontend: Vite inlines VITE_* vars
# into the public bundle.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
# Addis AI handles Amharic (am) and Afan Oromo (om).
ADDIS_AI_API_KEY=
# elevenlabs | addis
STT_PROVIDER=elevenlabs
# elevenlabs | gemini — Gemini speaks questions using LLM_API_KEY, so a setup with
# no ElevenLabs account still has an interviewer voice.
TTS_PROVIDER=elevenlabs
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
INTERVIEW_LANGUAGE=en
INTERVIEW_MAX_TURNS=5

VITE_API_BASE_URL=http://localhost:8000
# Public ElevenLabs agent for voice practice — an ID only, never an API key.
VITE_ELEVENLABS_AGENT_ID=

# Use false whenever the FastAPI backend is running. Mock auth creates local-only
# users that do not exist in the database, so AI Interview sessions fail with
# "User not found" if this is left true.
VITE_USE_MOCK_API=false
